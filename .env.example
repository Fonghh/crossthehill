# Copy to .env.local to override. All optional.

# Self-hosted PeerJS signalling (default: free PeerJS cloud 0.peerjs.com)
# For LAN testing run `npm run peer-server` and use your computer's LAN IP:
# VITE_PEER_HOST=192.168.1.10
# VITE_PEER_PORT=9000
# VITE_PEER_PATH=/cth
# VITE_PEER_SECURE=false

# TURN credential endpoint (default in production builds: ./api/turn on Cloudflare Pages)
# VITE_TURN_ENDPOINT=https://example.pages.dev/api/turn
